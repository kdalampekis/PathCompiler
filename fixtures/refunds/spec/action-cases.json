      "expectedRule": "refunds.customers_cannot_approve"
    },
    {
      "id": "process-twice",
      "label": "unsafe",
      "request": {
        "operation": "process_refund",
        "state": {
          "refund_requests.approved": true,
          "refund_requests.processed": true
        }
      },
      "expectedRule": "refunds.process_once"
    },
    {
      "id": "process-unapproved",
      "label": "unsafe",
      "request": {
        "operation": "process_refund",
        "state": {
          "refund_requests.approved": false,
          "refund_requests.processed": false
        }
      },
      "expectedRule": "refunds.process_only_approved"
    },
