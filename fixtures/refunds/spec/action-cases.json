{
  "description": "Labeled actions for the refund specification. Safe actions must pass; unsafe ones must be blocked, naming the rule when one is expected.",
  "cases": [
    {
      "id": "agent-6000-without-approval",
      "label": "unsafe",
      "request": {
        "operation": "refund",
        "inputs": {
          "payment_id": 1,
          "amount": 6000,
          "manager_approval": false
        },
        "context": {
          "actor.role": "support_agent",
          "actor.id": "a1"
        },
        "state": {
          "payments.original_amount": 10000,
          "payments.refunded_amount": 0
        }
      },
      "expectedRule": "refunds.manager_approval_over_limit",
      "note": "the rule the example tests do not cover"
    },
    {
      "id": "manager-6000-without-approval",
      "label": "unsafe",
      "request": {
        "operation": "refund",
        "inputs": {
          "payment_id": 1,
          "amount": 6000,
          "manager_approval": false
        },
        "context": {
          "actor.role": "manager",
          "actor.id": "m1"
        },
        "state": {
          "payments.original_amount": 10000,
          "payments.refunded_amount": 0
        }
      },
      "expectedRule": "refunds.manager_approval_over_limit"
    },
    {
      "id": "customer-refund",
      "label": "unsafe",
      "request": {
        "operation": "refund",
        "inputs": {
          "payment_id": 1,
          "amount": 100,
          "manager_approval": false
        },
        "context": {
          "actor.role": "customer",
          "actor.id": "a1"
        },
        "state": {
          "payments.original_amount": 10000,
          "payments.refunded_amount": 0
        }
      },
      "expectedRule": "refunds.customers_cannot_refund"
    },
    {
      "id": "exceeds-remaining",
      "label": "unsafe",
      "request": {
        "operation": "refund",
        "inputs": {
          "payment_id": 1,
          "amount": 200,
          "manager_approval": false
        },
        "context": {
          "actor.role": "manager",
          "actor.id": "m1"
        },
        "state": {
          "payments.original_amount": 1000,
          "payments.refunded_amount": 900
        }
      },
      "expectedRule": "refunds.within_remaining_balance"
    },
    {
      "id": "zero-amount",
      "label": "unsafe",
      "request": {
        "operation": "refund",
        "inputs": {
          "payment_id": 1,
          "amount": 0,
          "manager_approval": false
        },
        "context": {
          "actor.role": "manager",
          "actor.id": "m1"
        },
        "state": {
          "payments.original_amount": 1000,
          "payments.refunded_amount": 0
        }
      },
      "expectedRule": "refund.amount > 0"
    },
    {
      "id": "negative-amount",
      "label": "unsafe",
      "request": {
        "operation": "refund",
        "inputs": {
          "payment_id": 1,
          "amount": -5,
          "manager_approval": false
        },
        "context": {
          "actor.role": "manager",
          "actor.id": "m1"
        },
        "state": {
          "payments.original_amount": 1000,
          "payments.refunded_amount": 0
        }
      },
      "expectedRule": "refund.amount > 0"
    },
    {
      "id": "above-api-limit",
      "label": "unsafe",
      "request": {
        "operation": "refund",
        "inputs": {
          "payment_id": 1,
          "amount": 150000,
          "manager_approval": true
        },
        "context": {
          "actor.role": "manager",
          "actor.id": "m1"
        },
        "state": {
          "payments.original_amount": 200000,
          "payments.refunded_amount": 0
        }
      },
      "expectedRule": "refund.amount <= 100000"
    },
    {
      "id": "self-approval",
      "label": "unsafe",
      "request": {
        "operation": "approve_refund",
        "context": {
          "actor.role": "manager",
          "actor.id": "m1"
        },
        "state": {
          "refund_requests.requester_id": "m1",
          "refund_requests.approved": false
        }
      },
      "expectedRule": "refunds.no_self_approval"
    },
    {
      "id": "support-approves",
      "label": "unsafe",
      "request": {
        "operation": "approve_refund",
        "context": {
          "actor.role": "support_agent",
          "actor.id": "a1"
        },
        "state": {
          "refund_requests.requester_id": "a2",
          "refund_requests.approved": false
        }
      },
      "expectedRule": "refunds.support_cannot_approve"
    },
    {
      "id": "customer-approves",
      "label": "unsafe",
      "request": {
        "operation": "approve_refund",
        "context": {
          "actor.role": "customer",
          "actor.id": "c1"
        },
        "state": {
          "refund_requests.requester_id": "a2",
          "refund_requests.approved": false
