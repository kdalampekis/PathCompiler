{
  "declaredBy": "finance-policy@example.com",
  "reference": "Refund policy v3, section 2 (fixture)",
  "businessRules": [
    {
      "id": "refunds.manager_approval_over_limit",
      "description": "A refund above 5000 needs manager approval.",
      "when": "refund.amount > 5000",
      "must": "refund.manager_approval == true",
      "appliesTo": ["refund"]
    },
    {
      "id": "refunds.within_remaining_balance",
      "description": "A refund cannot exceed what is left to refund on the payment.",
      "when": "true",
      "must": "refund.amount <= payments.original_amount - payments.refunded_amount",
      "appliesTo": ["refund"]
    },
    {
      "id": "refunds.no_self_approval",
      "description": "Nobody approves their own refund request.",
      "when": "true",
      "must": "actor.id != refund_requests.requester_id",
      "appliesTo": ["approve_refund"]
    },
    {
      "id": "refunds.process_once",
      "description": "A refund request is processed at most once.",
      "when": "true",
      "must": "!refund_requests.processed",
      "appliesTo": ["process_refund"]
    },
    {
      "id": "refunds.process_only_approved",
      "description": "Only an approved refund request is processed.",
      "when": "true",
      "must": "refund_requests.approved",
      "appliesTo": ["process_refund"]
    }
  ],
  "permissions": [
    {
      "id": "refunds.customers_cannot_refund",
      "description": "Customers never issue refunds.",
      "role": "customer",
      "action": "refund",
      "effect": "deny"
    },
    {
      "id": "refunds.support_cannot_approve",
      "description": "Support agents never approve refunds.",
      "role": "support_agent",
      "action": "approve_refund",
      "effect": "deny"
    },
    {
      "id": "refunds.customers_cannot_approve",
      "description": "Customers never approve refunds.",
      "role": "customer",
      "action": "approve_refund",
      "effect": "deny"
    }
  ]
}
