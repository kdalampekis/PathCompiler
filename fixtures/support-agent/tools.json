            "amount": { "type": "integer", "minimum": 1, "maximum": 20000 },
            "manager_approval": { "type": "boolean" },
            "reason": { "type": "string" }
          },
          "required": ["amount", "manager_approval"]
        }
      }
    },
    {
      "name": "escalate",
      "description": "Hand the conversation to a person.",
      "input_schema": {
        "type": "object",
        "properties": {
          "priority": { "type": "string", "enum": ["low", "high"] }
        },
        "required": ["priority"]
      }
    }
  ]
}
