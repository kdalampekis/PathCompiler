{
  "name": "pathcompiler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "build:packages": "pnpm --filter './packages/*' build",
    "typecheck": "pnpm build:packages && tsc --noEmit && pnpm -r typecheck",
    "test": "pnpm build:packages && vitest run",
    "test:e2e": "pnpm build:packages && pnpm --filter @pathcompiler/next-demo test:e2e && pnpm --filter @pathcompiler/workflow-validator test:browser",
    "build": "pnpm -r build",
    "dev": "pnpm --filter @pathcompiler/next-demo dev",
    "pathcompiler": "node packages/cli/dist/bin.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
