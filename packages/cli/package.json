{
  "name": "@pathcompiler/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "pathcompiler": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pathcompiler/adapter-nextjs": "workspace:*",
    "@pathcompiler/git-intelligence": "workspace:*",
    "@pathcompiler/source-model": "workspace:*",
    "@pathcompiler/test-miner-playwright": "workspace:*"
  }
}
